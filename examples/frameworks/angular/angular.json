{
  "version": 1,
  "cli": {
    "analytics": false
  },
  "projects": {
    "viewer": {
      "projectType": "application",
      "root": "",
      "sourceRoot": ".",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "main.ts",
            "index": "index.html",
            "tsConfig": "tsconfig.json",
            "outputPath": "dist",
            "styles": ["public/style.css"],
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ]
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "viewer:build"
          }
        }
      }
    }
  }
}
