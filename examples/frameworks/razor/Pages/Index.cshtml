<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>OnoDocs Razor Pages viewer</title><link rel="stylesheet" href="/style.css"></head><body><main><h1>Word document viewer</h1><p>Open a local Word file or the included sample. Selected files stay in your browser.</p><a href="https://github.com/onodocs/onodocs/tree/main/examples/frameworks/razor">Source on GitHub</a><div class="toolbar"><button id="toggle" type="button">Hide viewer</button></div><div id="viewer"></div><template id="viewer-template"><section><div class="toolbar"><label>Open Word file <input type="file" accept=".docx,.docm,.dotx,.dotm"></label><button type="button" data-open>Open sample</button><button type="button" data-cancel>Cancel loading</button></div><output role="status">Opening document…</output><div class="viewport"><div class="pages"></div></div></section></template></main><script type="module" src="/viewer.js"></script></body></html>
